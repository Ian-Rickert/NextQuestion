{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "pnpm --filter @workspace/api-server run build:function"
      ]
    }
  ],
  "hosting": {
    "public": "artifacts/press-conference-sim/dist/public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "predeploy": ["pnpm run build:web"],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
